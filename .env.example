# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# After setting these:
# 1. Restart the Vite dev server.
# 2. Enable Google in Supabase Authentication -> Providers.
# 3. Add http://localhost:5173 to Authentication -> URL Configuration -> Redirect URLs.
